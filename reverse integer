class Solution:
    def reverse(self, x: int) -> int:
        INT_MAX = 2**31 - 1   #  2147483647
        INT_MIN = -2**31      # -2147483648

        sign = -1 if x < 0 else 1
        x = abs(x)
        rev = 0

        while x:
            digit = x % 10
            x //= 10

            # rev * 10 + digit must stay <= INT_MAX (7 is last digit of INT_MAX)
            if rev > INT_MAX // 10 or (rev == INT_MAX // 10 and digit > 7):
                return 0
            rev = rev * 10 + digit

        return sign * rev
